  } else {
    textEl.style.display=''; editWrap.style.display='none';
    actions.style.display=currentPopupBlockId?'flex':'none'; saveActions.style.display='none';
    if(photoView) renderPopupPhotos(currentPopupPhotos,'rp-photos');
