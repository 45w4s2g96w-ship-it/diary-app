async function loadTodayRecords() {
  try {
    const pageId=await getTodayPageId(); if(!pageId) return;
    const notionUrl='https://notion.so/'+pageId.replace(/-/g,'');
    let allBlocks=[];
    let cursor=undefined;
    // 페이지네이션으로 전체 블록 가져오기
    do {
      const url=WORKER_URL+'/notion/blocks/'+pageId+'/children?page_size=100'+(cursor?'&start_cursor='+cursor:'');
      const res=await fetch(url,{headers:{'Content-Type':'application/json'}});
      const data=await res.json();
      allBlocks=allBlocks.concat(data.results||[]);
      cursor=data.has_more?data.next_cursor:undefined;
    } while(cursor);

    let i=0;
    while(i<allBlocks.length){
      const block=allBlocks[i];
      if(block.type!=='paragraph'){i++;continue;}
      const texts=block.paragraph?.rich_text||[]; if(!texts.length){i++;continue;}
      const content=texts.map(t=>t?.text?.content||'').join('');
      const lines=content.split('\n').map(l=>l.trim()).filter(l=>l); if(!lines.length){i++;continue;}
      if(!/^\d{2}:\d{2}$/.test(lines[0])){i++;continue;}
      const timeStr=lines[0];
      let mood='',text='';
      if(lines[1]){mood=lines[1].replace(/^[\u{1F300}-\u{1FFFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\s]+/u,'').trim();}
      if(lines[2]) text=lines.slice(2).join('\n');
      // 다음 블록이 column_list면 사진
      let photoUrls=[];
      let photoBlockId=null;
      if(i+1<allBlocks.length&&allBlocks[i+1].type==='column_list'){
        photoBlockId=allBlocks[i+1].id;
        // 사진 URL 추출 시도 (Worker가 column 내부까지 주면)
        const cols=allBlocks[i+1].column_list?.children||[];
        cols.forEach(col=>{
          const imgBlock=col.column?.children?.find(b=>b.type==='image');
          if(imgBlock) {
            const url=imgBlock.image?.external?.url||imgBlock.image?.file?.url||'';
            if(url) photoUrls.push(url);
          }
        });
        i++;
      }
      addRecordToUI(timeStr,mood,text,photoUrls,notionUrl,block.id,photoBlockId);
      i++;
    }
  } catch(e){console.error('load records failed',e);}
}


