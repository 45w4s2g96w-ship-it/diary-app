function renderBrainList(){
  const list=document.getElementById('brain-list');
  if(!brainItems.length){list.innerHTML='<div class="empty-state">꾹 눌러서 드래그하면 분류할 수 있어요.</div>';return;}
  list.innerHTML=brainItems.map((item,idx)=>`
