      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({filter:{property:'분석 완료',checkbox:{equals:true}},sorts:[{property:'날짜',direction:'descending'}],page_size:30})
    });
    const data=await res.json();
    if(!data.results||!data.results.length){list.innerHTML='<div class="inbox-empty">분석된 일기가 쌓이면<br>여기에 메시지가 와요.</div>';return;}
    list.innerHTML='';
    data.results.forEach(page=>{
      const props=page.properties;
      const dateStr=props['날짜']?.date?.start||''; if(!dateStr) return;
      const d=new Date(dateStr+'T00:00:00');
      const days=['일','월','화','수','목','금','토'];
      const dateLabel=`${d.getFullYear()}년 ${d.getMonth()+1}월 ${d.getDate()}일 ${days[d.getDay()]}요일`;
      const summary=getTextProp(props,'일기 요약')||'';
      const encourage=getTextProp(props,'격려')||'';
      const suggest=getTextProp(props,'제언')||'';

      const cut2=(text)=>{
        if(!text) return '';
        const s=text.match(/[^.!?。\n]+[.!?。]?/g)||[text];
        return s.slice(0,2).join(' ').trim();
      };

      // 제언 줄바꿈: 1), 2) 앞에서 줄바꿈
      const formatSuggest=(text)=>{
        if(!text) return '';
        return text.replace(/\s*([1-9]\))/g,'\n$1').trim();
      };

      const divider=document.createElement('div'); divider.className='inbox-date-divider'; divider.textContent=dateLabel;
      list.appendChild(divider);

      const bubble=document.createElement('div'); bubble.className='inbox-bubble';
      bubble.innerHTML=`
        ${summary?`<div class="inbox-bubble-summary">${cut2(summary)}</div>`:''}
        ${encourage?`<div class="inbox-bubble-encourage">${cut2(encourage)}</div>`:''}
        ${suggest?`<hr class="inbox-bubble-divider"><div class="inbox-bubble-suggest-label">오늘은 이렇게 해보세요 💡</div><div class="inbox-bubble-suggest">${formatSuggest(suggest)}</div>`:''}
      `;
      list.appendChild(bubble);
    });
  }catch(e){list.innerHTML='<div class="inbox-empty">불러오기 실패</div>';console.error(e);}
}

function getTextProp(props,key){
  const p=props[key]; if(!p) return '';
  if(p.rich_text) return p.rich_text.map(t=>t.plain_text).join('');
  if(p.select) return p.select.name; return '';
}



/* Todo Detail */
let currentDetailQuad='', currentDetailIdx=-1;

function openTodoDetail(q, idx) {
  currentDetailQuad=q; currentDetailIdx=idx;
  const item=todoData[q][idx];
  const cfg=QUAD_CFG[q];
  document.getElementById('td-quad-tag').textContent=cfg.label;
  document.getElementById('td-title').textContent=item.text;
  document.getElementById('td-memo').textContent=item.memo||'';
  document.getElementById('td-due').textContent=item.dueDate?'Due: '+formatDateShort(new Date(item.dueDate)):'No deadline';
  renderSubList();
  document.getElementById('td-sub-input').value='';
  document.getElementById('todo-detail-popup').classList.add('open');
}
function closeTodoDetail() { document.getElementById('todo-detail-popup').classList.remove('open'); }

function renderSubList() {
  const item=todoData[currentDetailQuad][currentDetailIdx];
  const list=document.getElementById('td-sub-list');
  if(!item.subs||!item.subs.length){list.innerHTML='';return;}
  list.innerHTML=item.subs.map((s,i)=>`
    <div class="td-sub-item">
      <div class="td-sub-check${s.done?' done':''}" onclick="toggleSubTodo(${i})"></div>
      <div class="td-sub-text${s.done?' done':''}">${s.text}</div>
    </div>`).join('');
}

function toggleSubTodo(subIdx) {
  const item=todoData[currentDetailQuad][currentDetailIdx];
  item.subs[subIdx].done=!item.subs[subIdx].done;
  if(item.subs[subIdx].notionId) updateTodoNotionDone(item.subs[subIdx].notionId, item.subs[subIdx].done);
  renderSubList(); renderAllQuads(); saveTodoToStorage();
}

function addSubTodo() {
  const text=document.getElementById('td-sub-input').value.trim(); if(!text) return;
  const item=todoData[currentDetailQuad][currentDetailIdx];
  if(!item.subs) item.subs=[];
  const sub={text,done:false,notionId:null};
  item.subs.push(sub);
  document.getElementById('td-sub-input').value='';
  renderSubList(); renderAllQuads(); saveTodoToStorage();
  saveSubTodoToNotion(text, item.notionId).then(id=>{if(id){sub.notionId=id;saveTodoToStorage();}});
}

function deleteTodoItem() {
  if(!confirm('삭제할까요?')) return;
  todoData[currentDetailQuad].splice(currentDetailIdx,1);
  closeTodoDetail(); renderAllQuads(); saveTodoToStorage(); showToast('삭제됐어요');
}


/* Todo Notion */
async function saveTodoToNotion(quad,text,dueDate){
  try{
    const cfg=QUAD_CFG[quad];
    const props={
      '이름':{title:[{text:{content:text}}]},
      '사분면':{select:{name:cfg.label}},
      '추가일':{date:{start:formatDate(new Date())}},
      '완료':{checkbox:false}
    };
    if(dueDate) props['마감일']={date:{start:formatDate(dueDate)}};
    const res=await fetch(WORKER_URL+'/notion/pages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({parent:{database_id:TODO_DB},properties:props})});
    const data=await res.json();
    return data.id||null;
  }catch(e){console.error('todo notion save failed',e);return null;}
}
async function saveSubTodoToNotion(text,parentId){
  try{
    const props={
      '이름':{title:[{text:{content:text}}]},
      '완료':{checkbox:false},
      '추가일':{date:{start:formatDate(new Date())}}
    };
    if(parentId) props['상위항목']={relation:[{id:parentId}]};
    const res=await fetch(WORKER_URL+'/notion/pages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({parent:{database_id:TODO_DB},properties:props})});
    const data=await res.json();
    return data.id||null;
  }catch(e){console.error('sub todo notion save failed',e);return null;}
}
async function updateTodoNotionDone(notionId,done){
  try{
    await fetch(WORKER_URL+'/notion/pages/'+notionId,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({properties:{'완료':{checkbox:done}}})});
  }catch(e){console.error('todo notion update failed',e);}
}

/* Book */
let bookData = [];
let currentBookIdx = -1;
let selectedSearchBook = null;
let bookSearchTimer = null;

function debounceBookSearch(val) {
  clearTimeout(bookSearchTimer);
  if(!val.trim()) { document.getElementById('book-search-results').style.display='none'; return; }
  bookSearchTimer = setTimeout(()=>searchBooks(val), 500);
}

async function searchBooks(query) {
  const q = query || document.getElementById('book-search-input').value.trim();
  if(!q) return;
  const resultsEl = document.getElementById('book-search-results');
  resultsEl.innerHTML = '<div style="font-family:Gothic A1,sans-serif;font-size:12px;font-weight:300;color:var(--ink-muted);padding:8px 0;">검색 중...</div>';
  resultsEl.style.display = 'flex';
  try {
    const res = await fetch(`https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(q)}&maxResults=8&langRestrict=ko&printType=books`);
    const data = await res.json();
    if(!data.items||!data.items.length) {
      resultsEl.innerHTML='<div style="font-family:Gothic A1,sans-serif;font-size:12px;color:var(--ink-muted);padding:8px 0;">검색 결과가 없어요.</div>';
      return;
    }
    resultsEl.innerHTML = '';
    data.items.forEach((item,i) => {
      const info = item.volumeInfo;
      const title = info.title||'';
      const authors = (info.authors||[]).join(', ');
      const genre = (info.categories||[])[0]||'';
      const cover = info.imageLinks?.thumbnail||info.imageLinks?.smallThumbnail||'';
      const el = document.createElement('div');
      el.className = 'book-search-item';
      el.innerHTML = `
        ${cover ? `<img class="book-search-cover" src="${cover.replace('http://','https://')}" onerror="this.style.display='none'">` : '<div class="book-search-cover"></div>'}
        <div class="book-search-info">
          <div class="book-search-title">${title}</div>
          <div class="book-search-author">${authors}</div>
          <div class="book-search-genre">${genre}</div>
        </div>`;
      el.onclick = () => {
        document.querySelectorAll('.book-search-item').forEach(e=>e.classList.remove('selected'));
        el.classList.add('selected');
        selectedSearchBook = { title, authors, genre, cover: cover.replace('http://','https://') };
        document.getElementById('book-genre-input').value = genre;
      };
      resultsEl.appendChild(el);
    });
  } catch(e) {
    resultsEl.innerHTML='<div style="font-family:Gothic A1,sans-serif;font-size:12px;color:var(--ink-muted);padding:8px 0;">검색 실패. 다시 시도해봐요.</div>';
  }
}

function openAddBookPopup() {
  selectedSearchBook = null;
  document.getElementById('book-search-input').value = '';
  document.getElementById('book-genre-input').value = '';
  document.getElementById('book-search-results').innerHTML = '';
  document.getElementById('book-search-results').style.display = 'none';
  document.getElementById('add-book-popup').classList.add('open');
  setTimeout(()=>document.getElementById('book-search-input').focus(), 300);
}
function closeAddBookPopup() { document.getElementById('add-book-popup').classList.remove('open'); }

async function confirmAddBook() {
  if(!selectedSearchBook) { showToast('책을 선택해주세요'); return; }
  const genre = document.getElementById('book-genre-input').value.trim() || selectedSearchBook.genre || '';
  const book = {
    title: selectedSearchBook.title,
    authors: selectedSearchBook.authors,
    genre,
    cover: selectedSearchBook.cover,
    reviews: [],
    notionId: null
  };
  bookData.unshift(book);
  closeAddBookPopup();
  renderBookList();
  saveBookToStorage();
  // 노션에 저장
  try {
    const props = {
      '이름': { title: [{ text: { content: book.title } }] },
      '장르': { select: { name: genre||'기타' } }
    };
    const res = await fetch(WORKER_URL+'/notion/pages', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ parent:{database_id:BOOK_DB}, properties: props })
    });
    const data = await res.json();
    book.notionId = data.id||null;
    saveBookToStorage();
  } catch(e) { console.error('book notion save failed',e); }
  showToast('추가됐어요!');
}

function renderBookList() {
  const list = document.getElementById('book-list');
  if(!bookData.length) { list.innerHTML='<div class="empty-state">추가한 책이 없어요.</div>'; return; }
  list.innerHTML = bookData.map((book,i) => `
    <div class="book-card" onclick="openBookDetail(${i})">
      ${book.cover ? `<img class="book-cover-img" src="${book.cover}" onerror="this.outerHTML='<div class=book-cover-placeholder>📖</div>'">` : '<div class="book-cover-placeholder">📖</div>'}
      <div class="book-card-info">
        <div>
          <div class="book-card-title">${book.title}</div>
          <div class="book-card-author">${book.authors||''}</div>
        </div>
        <div class="book-card-meta">
          <span class="book-genre-tag">${book.genre||'기타'}</span>
          <span class="book-review-count">${book.reviews.length ? book.reviews.length+'개' : '독후감 없음'}</span>
        </div>
      </div>
    </div>`).join('');
}

function openBookDetail(idx) {
  currentBookIdx = idx;
  const book = bookData[idx];
  document.getElementById('book-detail-header').innerHTML = `
    ${book.cover ? `<img class="book-detail-cover" src="${book.cover}">` : '<div class="book-detail-cover"></div>'}
    <div class="book-detail-info">
      <div class="book-detail-title">${book.title}</div>
      <div class="book-detail-author">${book.authors||''} · ${book.genre||''}</div>
    </div>`;
  renderReviews();
  // Switch to book-detail tab
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  document.getElementById('tab-book-detail').classList.add('active');
}

function closeBookDetail() {
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  document.getElementById('tab-book').classList.add('active');
  // Keep tab bar book button active
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector('.tab-btn[onclick*="book"]').classList.add('active');
}

function renderReviews() {
  const list = document.getElementById('review-list');
  const book = bookData[currentBookIdx];
  if(!book.reviews.length) { list.innerHTML='<div class="empty-state">아직 독후감이 없어요.</div>'; return; }
  list.innerHTML = book.reviews.map(r => `
    <div class="review-item">
      <div class="review-date">${r.date}</div>
      <div class="review-text">${r.text}</div>
    </div>`).join('');
}

function openAddReviewPopup() {
  const now = new Date();
  const days=['일','월','화','수','목','금','토'];
  const dateLabel=`${now.getFullYear()}년 ${now.getMonth()+1}월 ${now.getDate()}일 ${days[now.getDay()]}요일`;
  document.getElementById('review-date-label').textContent = dateLabel;
  document.getElementById('review-input').value = '';
  document.getElementById('add-review-popup').classList.add('open');
  setTimeout(()=>document.getElementById('review-input').focus(), 300);
}
function closeAddReviewPopup() { document.getElementById('add-review-popup').classList.remove('open'); }

async function confirmAddReview() {
  const text = document.getElementById('review-input').value.trim();
  if(!text) return;
  const book = bookData[currentBookIdx];
  const now = new Date();
  const days=['일','월','화','수','목','금','토'];
  const dateLabel=`${now.getFullYear()}년 ${now.getMonth()+1}월 ${now.getDate()}일 ${days[now.getDay()]}요일`;
  const review = { date: dateLabel, text };
  book.reviews.unshift(review);
  closeAddReviewPopup();
  renderReviews();
  renderBookList();
  saveBookToStorage();
  // 노션 페이지 본문에 블록 추가 — 날짜 / 내 생각 / 필사 구조
  if(book.notionId) {
    try {
      const children = [
        { object:'block', type:'heading_3', heading_3:{ rich_text:[{type:'text',text:{content:'📅 '+dateLabel}}] } },
        { object:'block', type:'heading_3', heading_3:{ rich_text:[{type:'text',text:{content:'💭 내 생각'}}] } },
        { object:'block', type:'paragraph', paragraph:{ rich_text:[{type:'text',text:{content:text}}] } },
        { object:'block', type:'heading_3', heading_3:{ rich_text:[{type:'text',text:{content:'✍️ 필사'}}] } },
        { object:'block', type:'callout', callout:{ rich_text:[{type:'text',text:{content:'필사 내용을 여기에 입력하거나 사진을 첨부하세요.'}}], icon:{emoji:'✍️'}, color:'gray_background' } },
        { object:'block', type:'divider', divider:{} }
      ];
      await fetch(WORKER_URL+'/notion/blocks/'+book.notionId+'/children', {
        method:'PATCH', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ children })
      });
    } catch(e) { console.error('review notion save failed',e); }
  }
  showToast('저장됐어요!');
}

function saveBookToStorage() { localStorage.setItem('book_data', JSON.stringify(bookData)); }
function loadBookFromStorage() {
  try { const d=localStorage.getItem('book_data'); if(d) bookData=JSON.parse(d); } catch(e){}
}


/* Toast */
function showToast(msg){
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2200);
}

/* PWA */
async function registerSW(){
  if(!('serviceWorker' in navigator)) return;
  try{
    await navigator.serviceWorker.register('./sw.js');
    if('Notification' in window && Notification.permission==='default'){
      const perm=await Notification.requestPermission();
    }
  }catch(e){console.error('SW failed',e);}
}

/* Init */
function init(){
  document.getElementById('current-date').textContent=formatDateDisplay(getDiaryDate());
  initQuadDates();
  loadTodoFromStorage(); loadCartFromStorage(); loadBookFromStorage();
  autoMoveTodos(); renderAllQuads(); renderCart(); renderBrainList(); renderBookList();
  loadTodayRecords(); registerSW();
  setInterval(autoMoveTodos,60000);
}

window.onload=()=>{
  if(localStorage.getItem('app_authed')==='1'&&localStorage.getItem('notion_token')){
    document.getElementById('setup-screen').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    init();
  }
};
