  const editWrap=document.getElementById('rp-edit-wrap');
  const editInput=document.getElementById('rp-edit-input');
  const actions=document.getElementById('rp-actions');
  const saveActions=document.getElementById('rp-save-actions');
  const photoView=document.getElementById('rp-photos');
  const photoEdit=document.getElementById('rp-photos-edit');
  if(isEditing){
    editInput.value=textEl.textContent;
    editingPhotos=[...currentPopupPhotos];
    textEl.style.display='none'; editWrap.style.display='';
