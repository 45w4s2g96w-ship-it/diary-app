/* Todo */
const QUAD_CFG = {
  today:{label:'Today',offset:0},
  week:{label:'This Week',offset:7},
  month:{label:'This Month',offset:30},
  someday:{label:'Someday',offset:null}
};
let todoData={today:[],week:[],month:[],someday:[]};
let currentQuad='';

function initQuadDates(){
  document.getElementById('due-today').textContent=formatDateShort(new Date());
  document.getElementById('due-week').textContent='+7d  '+formatDateShort(getOffsetDate(7));
  document.getElementById('due-month').textContent='+30d  '+formatDateShort(getOffsetDate(30));
}
function openTodoPopup(q) {
  currentQuad=q; const cfg=QUAD_CFG[q];
  document.getElementById('todo-popup-label').textContent=cfg.label;
  document.getElementById('todo-popup-due').textContent=cfg.offset===null?'No deadline':cfg.offset===0?'Due today':'Due in +'+cfg.offset+' days';
  document.getElementById('todo-input').value='';
  document.getElementById('todo-popup').classList.add('open');
  setTimeout(()=>document.getElementById('todo-input').focus(),300);
}
function closeTodoPopup(){document.getElementById('todo-popup').classList.remove('open');}
function confirmTodo(){
  const text=document.getElementById('todo-input').value.trim(); if(!text) return;
  const cfg=QUAD_CFG[currentQuad];
  let dueDate=null;
  if(cfg.offset!==null){dueDate=new Date();dueDate.setDate(dueDate.getDate()+cfg.offset);dueDate.setHours(23,59,59,0);}
  const item={text,dueDate,done:false,addedAt:new Date(),notionId:null};
  todoData[currentQuad].push(item);
  closeTodoPopup(); renderAllQuads(); showToast('Added!'); saveTodoToStorage();
  saveTodoToNotion(currentQuad,text,dueDate).then(id=>{if(id){item.notionId=id;saveTodoToStorage();}});
}
function toggleTodo(q,idx,e){
  e.stopPropagation();
  todoData[q][idx].done=!todoData[q][idx].done;
  if(todoData[q][idx].notionId) updateTodoNotionDone(todoData[q][idx].notionId, todoData[q][idx].done);
  autoMoveTodos(); renderAllQuads(); saveTodoToStorage();
}
function autoMoveTodos(){
  const now=new Date();
  ['month','week'].forEach(q=>{
    const keep=[];
    todoData[q].forEach(item=>{
      if(item.done||!item.dueDate){keep.push(item);return;}
      const days=(item.dueDate-now)/86400000;
      if(q==='month'&&days<=7){item.movedFrom='month';todoData.week.push(item);}
      else if(q==='week'&&days<=0){item.movedFrom='week';todoData.today.push(item);}
      else keep.push(item);
    });
    todoData[q]=keep;
  });
}
function renderQuad(q){
  const c=document.getElementById('items-'+q); const now=new Date();
  if(!todoData[q].length){c.innerHTML='';return;}
  c.innerHTML=todoData[q].map((item,i)=>{
    const od=item.dueDate&&!item.done&&item.dueDate<now;
    const subCount=item.subs?item.subs.filter(s=>!s.done).length:0;
    return `<div class="quad-item" onclick="openTodoDetail('${q}',${i})">
      <div class="quad-check${item.done?' done':''}" onclick="toggleTodo('${q}',${i},event)"></div>
      <div class="quad-text${item.done?' done':''}">${item.text}${od?'<span class="quad-overdue"> Overdue</span>':''}${subCount>0?'<span class="quad-sub-count"> +'+subCount+'</span>':''}</div>
    </div>`;
  }).join('');
}
function renderAllQuads(){['today','week','month','someday'].forEach(renderQuad);}
function saveTodoToStorage(){localStorage.setItem('todo_data',JSON.stringify(todoData));}
function loadTodoFromStorage(){
  try{const d=localStorage.getItem('todo_data');if(d){const p=JSON.parse(d);Object.keys(p).forEach(q=>{if(todoData[q])todoData[q]=p[q].map(i=>({...i,dueDate:i.dueDate?new Date(i.dueDate):null}));});}}catch(e){}
}

